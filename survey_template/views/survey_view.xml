<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="survey_survey_view_form" model="ir.ui.view">
        <field name="name">survey.template</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <label for="is_template" string="Är mall"/>
                <field name="is_template" />
            </xpath>

<!--            <field name="survey_type" position="after">-->
<!--                <label for="is_template" string="Är mall"/>-->
<!--                <field name="is_template" />-->
<!--            </field>-->
            <button name="action_send_survey" position="after">
                <button name="new_from_template" type="object" string="Skapa från mall" attrs="{'invisible': [('is_template', '=', False)]}"/>
             </button>
        </field>
    </record>

    <record id="survey_survey_view_tree" model="ir.ui.view">
        <field name="name">survey.template</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_tree" />
        <field name="arch" type="xml">
            <field name="title" position="replace">
                <field name="display_name" />
            </field>
        </field>
    </record>

    <record id="survey_survey_view_kanban" model="ir.ui.view">
        <field name="name">survey.template</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='title']" position="replace">
                <field name="display_name" />
            </xpath>
        </field>
    </record>

    <record id="survey_survey_view_search" model="ir.ui.view">
        <field name="name">survey.template</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_search" />
        <field name="arch" type="xml">
            <field name="title" position="after">
                <field name="is_template"/>
            </field>
            <filter name="not_certification" position="after">
                <filter string="Is Template" name="template" domain="[('is_template', '=', True)]" />
                <filter string="Is Not Template" name="template" domain="[('is_template', '=', False)]" />
            </filter>
        </field>
    </record>
</odoo>
