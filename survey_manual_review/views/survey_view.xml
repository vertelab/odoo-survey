<odoo>
    <data>
        <record model="ir.ui.view" id="survey_survey_view_form">
            <field name="name">survey_survey_view_form</field>
            <field name="model">survey.survey</field>
            <field name="inherit_id" ref="survey.survey_survey_view_form"/>
            <field name="arch" type="xml">
               <field name="scoring_type" position="before">
                   <field name="needs_manual_review"/>
               </field>
            </field>
         </record>
         
        <record model="ir.ui.view" id="slide_channel_view_form">
            <field name="name">survey_user_input_view_form</field>
            <field name="model">slide.channel</field>
            <field name="inherit_id" ref="website_slides.view_slide_channel_form"/>
            <field name="arch" type="xml">
                    <button name="action_view_slides" position="before">
                            <button name="action_show_surveys" type="object" icon="fa-files-o" class="oe_stat_button">
                                <field name="surveys_manual_review_count" widget="statinfo" string="Inlämningar"/>
                            </button>
                   </button>
            </field>
         </record>
         
        <record model="ir.ui.view" id="slide_channel_view_kanban">
            <field name="name">slide.channel.view.kanban</field>
            <field name="model">slide.channel</field>
            <field name="inherit_id" ref="website_slides.slide_channel_view_kanban"/>
            <field name="arch" type="xml">
                   <div name="info_avg_rating" position="after">
                        <div class="d-flex" name="info_manual_review_count" t-if="record.rating_count.raw_value">
                            <a name="action_show_surveys" type="object" class="me-auto"><field name="surveys_manual_review_count"/> Inlämningar</a>
                        </div>
                   </div>
            </field>
         </record>
         
        <record model="ir.ui.view" id="survey_user_input_view_form">
            <field name="name">survey_user_input_view_form</field>
            <field name="model">survey.user_input</field>
            <field name="inherit_id" ref="survey.survey_user_input_view_form"/>
            <field name="arch" type="xml">
               <button name="action_print_answers" position="after">
                  <button name="mark_manual_done" invisible="needs_manual_review == False or manually_reviewed == True" string="Mark as Done" type="object" class="oe_highlight"/>
               </button>
               <field name="scoring_type" position="after">
                   <field name="needs_manual_review" invisible="1"/>
                   <field name="manually_reviewed" invisible="needs_manual_review == False"/>
               </field>
            </field>
         </record>
         
    </data>
</odoo>
