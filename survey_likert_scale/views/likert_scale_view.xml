<?xml version="1.0"?>
<odoo>
    <record model="ir.ui.view" id="view_likert_scale_form">
        <field name="name">likert.scale.template.form</field>
        <field name="model">likert.scale.template</field>
        <field name="arch" type="xml">
            <form string="Likert Scale Template">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook groups="base.group_no_one">
                        <page string="Options" name="likert_scale_options">
                            <field name="option_ids">
                                <list string="Options" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="option" />
                                    <field name="score" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_likert_scale_tree">
        <field name="name">likert.scale.template.tree</field>
        <field name="model">likert.scale.template</field>
        <field name="arch" type="xml">
            <list string="Likert Scale Template">
                <field name="name" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_likert_scale">
        <field name="name">Likert Scale Template</field>
        <field name="res_model">likert.scale.template</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_likert_scale_tree"/>
    </record>

    <menuitem name="Likert Scale Template"
        id="menu_likert_scale"
        action="action_likert_scale"
        parent="survey.survey_menu_questions"
        sequence="10"/>

</odoo>
