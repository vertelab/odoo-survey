<odoo>
    <data>
        <record model="ir.ui.view" id="view_survey_question_form">
            <field name="name">survey.question.form</field>
            <field name="model">survey.question</field>
            <field name="inherit_id" ref="survey.survey_question_form"/>
            <field name="arch" type="xml">
               <field name="question_type" position="before">
                   <field name="is_likert_scale"/>
                   <field name="likert_scale_template_id" attrs="{'invisible': [('is_likert_scale', '=', False)], 'required': [('is_likert_scale', '=', True)]}"/>
               </field>
            </field>
         </record>
    </data>
</odoo>